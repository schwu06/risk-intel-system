# 应用
APP_NAME=企业风险情报日报系统
DATABASE_URL=sqlite:///./data/risk_intel.db
SECRET_KEY=change-me-in-production

# 秘塔 AI 搜索 API（官方文档: https://metaso.cn/search-api/playground）
MITA_API_BASE_URL=https://metaso.cn/api/v1
MITA_API_KEY=mk-your_metaso_api_key

# DeepSeek API
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-chat

# 深度研报正式生成模式。升级默认 legacy；切换后需重启应用。
INDUSTRY_REPORT_GENERATION_MODE=legacy
GROUNDED_REPORT_REQUIRE_APPROVAL=true
# 安全策略固定关闭：grounded 失败不会静默调用 legacy Prompt。
GROUNDED_REPORT_ALLOW_LEGACY_FALLBACK=false

# 调度（cron 表达式，默认每天 06:00 北京时间需按服务器时区调整）
DAILY_PIPELINE_CRON=0 6 * * *

# 近 N 小时资讯窗口（点击「开始运行」采集范围）
NEWS_WINDOW_HOURS=24
NEWS_FETCH_BODY=true
NEWS_MAX_BODY_ITEMS=8

# 外网偶发 DNS/超时自动重试（提高一次采集成功率）
NETWORK_RETRY_ATTEMPTS=3
NETWORK_RETRY_BACKOFF_SECONDS=1.5

# 流水线韧性
PIPELINE_ASYNC_DEFAULT=true
PIPELINE_LLM_TOP_K=8
PIPELINE_LLM_CACHE_HOURS=168
PIPELINE_MITA_QUERY_PAUSE_SECONDS=0.3
# 秘塔不足才补：主源有效候选 ≥ 此值则跳过；0 = 跟随 PIPELINE_LLM_TOP_K
PIPELINE_MITA_MIN_ITEMS=0
# 主源硬故障（RSS 全挂 / 模块 C 的 TDnet API 失败）时强制补秘塔
PIPELINE_MITA_FORCE_ON_PRIMARY_FAIL=true
# SQLite 下建议 false，避免并行写库拖慢侧栏/上传
PIPELINE_MODULE_PARALLEL=false
PIPELINE_MERGE_LLM=true
NEWS_FETCH_BODY=false
RSS_CONFIG_PATH=config/rss_feeds.yaml
NETWORK_RETRY_ATTEMPTS=2
NETWORK_RETRY_BACKOFF_SECONDS=1.2
